# Copy to .env and fill in what you use.

# ComfyUI address seen from the app container. Default: the bundled comfyui service.
# Hardware profile: lite (~8 GB VRAM, default) or full (16-24 GB VRAM). Use "all" to download both.
COMFYUI_PROFILE=lite

# For a ComfyUI already running on this computer:
# COMFYUI_URL=http://host.docker.internal:8188

# Only if Hugging Face asks for a login when downloading models.
HF_TOKEN=

# Optional cloud backends (can also be entered in Settings).
FAL_KEY=
GEMINI_API_KEY=

# Set a password to require a login (user name defaults to "family").
SCENEGEN_PASSWORD=
SCENEGEN_USER=family
